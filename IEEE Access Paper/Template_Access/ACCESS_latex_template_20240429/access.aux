\@writefile{toc}{\contentsline {section}{\numberline {II}System Overview}{4}{}\protected@file@percent }
\newlabel{sec:overview}{{II}{4}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three-layer block diagram of the proposed system. The top layer offloads all neural inference to the Hailo-8L, the middle layer routes detections through mode-gated response engines, and the bottom layer handles persistence and external access --- separating concerns so that no single layer's failure propagates upward.}}{4}{}\protected@file@percent }
\newlabel{fig:block_diagram}{{1}{4}}
\@writefile{toc}{\contentsline {section}{\numberline {III}Dataset}{4}{}\protected@file@percent }
\newlabel{sec:dataset}{{III}{4}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {III-A}}Source Datasets}{4}{}\protected@file@percent }
