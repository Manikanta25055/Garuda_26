\newlabel{sec:dataset_limits}{{\mbox  {III-A}}{4}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces End-to-end runtime diagram of a danger event. The full path from camera to email/WebSocket/clip upload completes in under 25\,ms of on-device processing; the mode gate short-circuits all downstream work during quiet periods, and six parallel subsystems run asynchronously without blocking the inference thread.}}{5}{}\protected@file@percent }
\newlabel{fig:system_flowchart}{{2}{5}}
