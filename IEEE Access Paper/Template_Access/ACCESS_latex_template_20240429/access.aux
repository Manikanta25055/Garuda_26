\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-A}}Training Loss Convergence}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Training loss convergence over 150 epochs. All three loss components fall monotonically (box: $1.65 \to 0.74$; classification: $2.80 \to 0.49$), and the train--validation gap stays narrow throughout, indicating generalisation rather than memorisation.}}{10}{}\protected@file@percent }
\newlabel{fig:training_losses}{{7}{10}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-B}}Validation mAP and Precision / Recall}{10}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Validation metrics versus training epoch. mAP{@}0.5 plateaus near 0.81 by epoch\nobreakspace  {}100, while precision (0.87) and recall (0.80) converge to a balanced operating point with no sign of precision--recall trade-off collapse.}}{10}{}\protected@file@percent }
\newlabel{fig:training_metrics}{{8}{10}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-C}}Four-Model Performance Comparison}{11}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Four-model comparison on the held-out test set. COCO-pretrained YOLOv8s scores near zero on this four-class task; fine-tuning on 359 images (v1) recovers to 0.465 mAP{@}0.5, the intermediate v2 (1{,}383 images) reaches 0.754, and v5 (4{,}982 images) reaches 0.847 --- an 82\% gain over v1 driven entirely by dataset growth.}}{11}{}\protected@file@percent }
\newlabel{fig:model_comparison}{{9}{11}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-D}}Per-Class mAP{@}0.5 Progression}{11}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Per-class mAP{@}0.5 progression across v1, v2, and v5. Knife shows the largest single-class gain ($+0.66$); Scissors reaches the highest absolute score (0.967); Person remains the hardest class at 0.647. All four classes improve monotonically with dataset scale.}}{11}{}\protected@file@percent }
\newlabel{fig:per_class_map}{{10}{11}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces {\fontencoding  {T1}\fontseries  {b}\selectfont  {P}er-Class Recall and mAP{@}0.5: v1 vs v5 (Deployed)}}}{11}{}\protected@file@percent }
\newlabel{tab:v1_v5}{{6}{11}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-E}}Full Per-Class Metrics at v5}{11}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Full per-class metrics for the deployed v5 model. Scissors leads at 0.967 mAP{@}0.5 with balanced P/R above 0.92; Person lags at 0.647 mAP{@}0.5 with the lowest recall (0.609), reflecting its higher intra-class variability and small-object fraction.}}{11}{}\protected@file@percent }
\newlabel{fig:perclass_full}{{11}{11}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces {\fontencoding  {T1}\fontseries  {b}\selectfont  {F}ull Per-Class Scorecard at v5 (Test Set, 622 Images, 1{,}656 Instances)}}}{11}{}\protected@file@percent }
\newlabel{tab:v5_full}{{7}{11}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {VI-E}1}Why Person Recall Is Low, and Why We Did Not Chase It Further}{11}{}\protected@file@percent }
\newlabel{sec:person_recall_discussion}{{\mbox  {VI-E}1}{11}}
\citation{b1}
\citation{b5}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-F}}Normalised Confusion Matrix}{12}{}\protected@file@percent }
\newlabel{sec:confusion}{{\mbox  {VI-F}}{12}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-G}}Precision-Recall Curves}{12}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-H}}Hardware Inference Performance}{12}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Normalised confusion matrix on the v5 held-out test set. Off-diagonal confusion is at most 0.03; the dominant error mode is background false negatives (missed detections), not inter-class misclassification --- the safer failure mode for a security system, where a misclassified weapon still triggers an alert.}}{13}{}\protected@file@percent }
\newlabel{fig:confusion}{{12}{13}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Per-class precision--recall curves for the deployed v5 detector. Person exhibits the steepest precision drop-off, falling below 0.80 at low recall thresholds; Scissors holds $P > 0.90$ past $R = 0.90$ (AP\,=\,0.967). Knife and Hammer maintain smooth, well-separated curves (AP 0.886 and 0.889).}}{13}{}\protected@file@percent }
\newlabel{fig:pr_curves}{{13}{13}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Hardware inference performance on the Hailo-8L. The custom v5 HEF runs at 52.2\,FPS (18.4\,ms), 6\,FPS below the Hailo-provided reference (58.2\,FPS, 13.2\,ms); the 5\,ms gap is attributable to the baked-in custom NMS, and both sit well above the 30\,FPS surveillance floor.}}{13}{}\protected@file@percent }
\newlabel{fig:hw_perf}{{14}{13}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces {\fontencoding  {T1}\fontseries  {b}\selectfont  {Y}OLOv8 Variant Selection (Hailo-8L Budget)}}}{13}{}\protected@file@percent }
\newlabel{tab:arch_select}{{8}{13}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-I}}Sustained FPS Across Operating Modes}{13}{}\protected@file@percent }
\newlabel{sec:async_fps}{{\mbox  {VI-I}}{13}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces FPS-across-modes time series (1\nobreakspace  {}Hz probe). Shaded regions mark the scheduled mode windows; red dotted lines mark injected load events (9 danger triggers, 3 voice queries). The overall mean is $52.01 \pm 1.44$\nobreakspace  {}FPS; per-window means span only a 0.9\nobreakspace  {}FPS band, confirming the flat-envelope property of the asynchronous pipeline.}}{14}{}\protected@file@percent }
\newlabel{fig:fps_ts}{{15}{14}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-J}}INT8 Quantisation and Deployment Characteristics}{14}{}\protected@file@percent }
\newlabel{sec:quant}{{\mbox  {VI-J}}{14}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces {\fontencoding  {T1}\fontseries  {b}\selectfont  {F}P32 Baseline (test split) and INT8 Deployment Characteristics.} FP32 mAP measured on the held-out test split (622\nobreakspace  {}images, 1{,}656\nobreakspace  {}instances; Ultralytics \texttt  {val} with \texttt  {conf=0.001}, \texttt  {iou=0.7}). Independent INT8-on-test mAP was not completed (see text).}}{14}{}\protected@file@percent }
\newlabel{tab:quant}{{9}{14}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-K}}MobileNetV2 Classifier Evaluation}{14}{}\protected@file@percent }
\newlabel{sec:classifier_eval}{{\mbox  {VI-K}}{14}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces {\fontencoding  {T1}\fontseries  {b}\selectfont  {M}obileNetV2 v2 Confusion Matrix (500-Crop Held-Out Set, $t{=}0.50$)}}}{15}{}\protected@file@percent }
\newlabel{tab:cls_confusion}{{10}{15}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-L}}Scope of the Depth-Variance Pre-Filter}{15}{}\protected@file@percent }
\newlabel{sec:antispoof_eval}{{\mbox  {VI-L}}{15}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-M}}F1-Confidence Threshold Curves}{15}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Per-class F1 score versus confidence threshold. All four classes peak in the 0.25--0.27 band, matching YOLO's default threshold and eliminating the need for manual per-class tuning at deployment. Scissors reaches the highest peak F1 (0.690); Person the lowest (0.473).}}{15}{}\protected@file@percent }
\newlabel{fig:f1_conf}{{16}{15}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-N}}Effect of Training Dataset Size}{15}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {VI-O}}Validation-to-Test Generalisation Gap}{15}{}\protected@file@percent }
\citation{b25,b26}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Validation mAP{@}0.5 progression against training-set size. v1 (359 images) converges to a deceptively high val mAP ($\sim $0.88) that does not transfer (test 0.465); v5 (4{,}982 images) converges to 0.817 val and 0.847 test. The trajectory is single-seed, single-split, and the v2$\rightarrow $v5 additions are targeted at the weakest class (Section\nobreakspace  {}\ref {sec:dataset_limits}), so it is an empirical trajectory on one corpus rather than a randomised scaling law.}}{16}{}\protected@file@percent }
\newlabel{fig:v1v2}{{17}{16}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces {\fontencoding  {T1}\fontseries  {b}\selectfont  {T}raining Dataset Growth and Test mAP}}}{16}{}\protected@file@percent }
\newlabel{tab:dataset_versions}{{11}{16}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Validation-to-test mAP{@}0.5 gap across dataset versions. v1's 0.414-point gap (classic single-source overfit) collapses to $+0.030$ at v5, where test mAP exceeds validation mAP --- evidence that dataset diversity, not architecture changes, is the dominant lever for generalisation.}}{16}{}\protected@file@percent }
\newlabel{fig:overfit}{{18}{16}}
