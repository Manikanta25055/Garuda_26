\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three-layer block diagram of Project Garuda. The top layer offloads all neural inference to the Hailo-8L, the middle layer routes detections through mode-gated response engines, and the bottom layer handles persistence and external access --- separating concerns so that no single layer's failure propagates upward.}}{4}{}\protected@file@percent }
\newlabel{fig:block_diagram}{{1}{4}}
\newlabel{sec:dataset_limits}{{\mbox  {IV-A}}{4}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-B}}Preprocessing and Validation Pipeline}{4}{}\protected@file@percent }
\newlabel{sec:preprocess}{{\mbox  {IV-B}}{4}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces End-to-end runtime flowchart. A danger detection traverses the full path from camera to email/WebSocket/clip upload in under 25\,ms of on-device processing; the mode gate short-circuits all downstream work during quiet periods, and six parallel subsystems run asynchronously without blocking the inference thread.}}{5}{}\protected@file@percent }
\newlabel{fig:system_flowchart}{{2}{5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-C}}Final Dataset Geometry}{5}{}\protected@file@percent }
