\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Alert engine dataflow. The mode gate at the entry point short-circuits all downstream work during Do Not Disturb or Idle, while three parallel channels (WebSocket, SMTPS with 60\,s cooldown, and AES-256-CBC encrypted clip upload) ensure sub-second alert delivery when active.}}{8}{}\protected@file@percent }
\newlabel{fig:alert}{{6}{8}}
