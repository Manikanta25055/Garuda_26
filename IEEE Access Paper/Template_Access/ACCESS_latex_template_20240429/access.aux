\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-B}}Preprocessing and Validation Pipeline}{4}{}\protected@file@percent }
\newlabel{sec:preprocess}{{\mbox  {IV-B}}{4}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three-layer block diagram of Project Garuda. The top layer offloads all neural inference to the Hailo-8L, the middle layer routes detections through mode-gated response engines, and the bottom layer handles persistence and external access --- separating concerns so that no single layer's failure propagates upward.}}{5}{}\protected@file@percent }
\newlabel{fig:block_diagram}{{1}{5}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-C}}Final Dataset Geometry}{5}{}\protected@file@percent }
\newlabel{sec:dataset_geometry}{{\mbox  {IV-C}}{5}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces End-to-end runtime flowchart. A danger detection traverses the full path from camera to email/WebSocket/clip upload in under 25\,ms of on-device processing; the mode gate short-circuits all downstream work during quiet periods, and six parallel subsystems run asynchronously without blocking the inference thread.}}{6}{}\protected@file@percent }
\newlabel{fig:system_flowchart}{{2}{6}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces {\fontencoding  {T1}\fontseries  {b}\selectfont  {A}nnotated Instance Counts per Class per Split}}}{6}{}\protected@file@percent }
\newlabel{tab:instances}{{2}{6}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces v5 dataset class distribution across train, validation, and test splits. Person dominates with 13{,}057 instances while Hammer accounts for only 335, a 39:1 imbalance; despite this, Hammer retains strong per-class recall (0.848) because its images are tight and object-centric, whereas Person is the weakest class on per-frame metrics (recall 0.609) due to crowded-scene composition and a long tail of small, occluded, and truncated boxes (Section\nobreakspace  {}\ref {sec:person_recall_discussion}).}}{6}{}\protected@file@percent }
\newlabel{fig:dataset_dist}{{3}{6}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces {\fontencoding  {T1}\fontseries  {b}\selectfont  {M}obileNetV2 Classifier Dataset (v2)}}}{7}{}\protected@file@percent }
\newlabel{tab:mobilenet}{{3}{7}}
\@writefile{toc}{\contentsline {section}{\numberline {V}Methodology}{7}{}\protected@file@percent }
\newlabel{sec:methodology}{{V}{7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-A}}Hardware Engine}{7}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-B}}GStreamer TAPPAS Pipeline Engine}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Hardware topology. All neural inference is offloaded to the Hailo-8L over the single PCIe Gen3\nobreakspace  {}$\times $1 lane, freeing all four Cortex-A76 cores for the web server, voice assistant, and logging --- the key constraint that shapes every software design decision.}}{7}{}\protected@file@percent }
\newlabel{fig:hw_layer}{{4}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces GStreamer TAPPAS pipeline topology. The fork-and-mux design lets the bypass queue hold the raw frame while HailoNet runs inference on the NPU, so the CPU touches each frame only at the identity callback probe --- enabling the sustained 52.2\,FPS reported in Section\nobreakspace  {}\ref {sec:async_fps}.}}{7}{}\protected@file@percent }
\newlabel{fig:gstreamer}{{5}{7}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-C}}Detection Engine}{8}{}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-D}}Cascade Architecture}{8}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces {\fontencoding  {T1}\fontseries  {b}\selectfont  {C}ascade Latency Budget (Hailo-8L, Pi\nobreakspace  {}5)}}}{8}{}\protected@file@percent }
\newlabel{tab:cascade_latency}{{4}{8}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-E}}Alert Engine}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Alert engine dataflow. The mode gate short-circuits all downstream work during Do Not Disturb or Idle; the three asynchronous channels (WebSocket, SMTPS, AES-256-CBC encrypted clip upload) keep the slow paths off the inference thread, which is the precondition for the FPS-flatness result of Sec.\nobreakspace  {}\ref {sec:async_fps}.}}{8}{}\protected@file@percent }
\newlabel{fig:alert}{{6}{8}}
\citation{b16}
\citation{b16}
