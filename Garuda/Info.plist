<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Transport Security: plain HTTP only to the Pi on the home network
         (an IP address, a .local name). Everything else must be HTTPS; this used
         to allow HTTP to any host. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key>
        <true/>
    </dict>
    <!-- User Notifications usage description -->
    <key>NSUserNotificationUsageDescription</key>
    <string>Garuda alerts you when a person is detected by the security camera.</string>
    <!-- macOS minimum version enforced -->
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
</dict>
</plist>
