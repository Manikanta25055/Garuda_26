{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/basic_pipelines/garuda_web/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/basic_pipelines/garuda_web/index.html"
    }
  ]
}
