        <!-- SQLite event DB -->
        <mxCell id="sql" value="SQLite Event Sync DB&#xa;(events.db)&#xa;offline client catch-up&#xa;GET /api/events?since=T" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
