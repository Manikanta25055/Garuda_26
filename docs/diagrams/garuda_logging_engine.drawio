<mxfile host="app.diagrams.net" modified="2026-04-15" version="21.0">
  <diagram id="garuda-log" name="Logging Engine">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="t" value="Logging Engine — Garuda_web.py L560–700, system_logs/" style="text;html=1;align=center;strokeColor=none;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="8" width="700" height="22" as="geometry" />
        </mxCell>

        <!-- In-memory buffers -->
        <mxCell id="mem" value="In-Memory Buffers&#xa;alert_history (deque)&#xa;voice_log (deque)&#xa;system_log (deque)&#xa;voice_responses (deque)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="55" width="185" height="95" as="geometry" />
        </mxCell>

        <!-- Periodic flusher -->
        <mxCell id="flush" value="Periodic Disk Flusher&#xa;(daemon thread)&#xa;writes buffers to disk&#xa;every N seconds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="265" y="55" width="185" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="rounded=0;orthogonalLoop=1;" edge="1" source="mem" target="flush" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Permanent logs -->
        <mxCell id="perm" value="Permanent Log Files&#xa;perm_detection_log.txt&#xa;perm_system_log.txt&#xa;perm_voice_log.txt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="55" width="185" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="rounded=0;orthogonalLoop=1;" edge="1" source="flush" target="perm" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- JSON files -->
        <mxCell id="json" value="JSON State Files&#xa;alert_history.json&#xa;config.json&#xa;(system_logs/)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="510" y="200" width="185" height="75" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="rounded=0;orthogonalLoop=1;" edge="1" source="flush" target="json" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Log rotation -->
        <mxCell id="rot" value="Log Rotation&#xa;(7-day retention)&#xa;purge entries older than&#xa;7 days on startup/flush" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="265" y="240" width="185" height="75" as="geometry" />
