<mxfile host="app.diagrams.net" modified="2026-04-15" version="21.0">
  <diagram id="garuda-hw" name="Garuda — Hardware Layer">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Project Garuda — Hardware Layer" style="text;html=1;align=center;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="12" width="650" height="28" as="geometry" />
        </mxCell>

        <!-- ========== RASPBERRY PI 5 (central board) ========== -->
        <mxCell id="pi" value="&lt;b&gt;Raspberry Pi 5&lt;/b&gt;&#xa;BCM2712 · 4× Cortex-A76 @ 2.4 GHz&#xa;8 GB LPDDR4X&#xa;Raspberry Pi OS (64-bit)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="320" y="230" width="230" height="100" as="geometry" />
        </mxCell>

        <!-- ========== HAILO-8L AI HAT+ ========== -->
        <mxCell id="hailo" value="&lt;b&gt;Hailo-8L AI HAT+&lt;/b&gt;&#xa;13 TOPS NPU&#xa;HailoRT driver · /dev/hailo0&#xa;Runs: YOLOv8 / YOLOv6 / MiDaS&#xa;MobileNetV2 (.hef files)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=0;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- PCIe edge: Pi → Hailo -->
        <mxCell id="epc" value="PCIe Gen3 ×1&#xa;M.2 M-Key" style="rounded=0;orthogonalLoop=1;fontSize=10;fontStyle=2;html=1;" edge="1" source="pi" target="hailo" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ========== USB CAMERA ========== -->
        <mxCell id="usbcam" value="&lt;b&gt;USB Camera&lt;/b&gt;&#xa;/dev/video0&#xa;V4L2 · GStreamer v4l2src" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="175" height="65" as="geometry" />
        </mxCell>

        <!-- USB edge -->
