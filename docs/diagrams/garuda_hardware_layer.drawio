        <!-- ========== STORAGE ========== -->
        <mxCell id="storage" value="&lt;b&gt;Storage&lt;/b&gt;&#xa;microSD / USB-SSD&#xa;OS · .hef model files&#xa;JSON + TXT persistent logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b0b0b0;fontSize=11;fontStyle=0;" vertex="1" parent="1">
