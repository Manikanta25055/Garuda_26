        <!-- ========== SOFTWARE DRIVER LAYER (annotation bar) ========== -->
        <mxCell id="swbar" value="Software Drivers on Pi 5:   hailo_pci (DKMS kernel module)  ·  HailoRT 4.x  ·  TAPPAS 3.x  ·  GStreamer 1.x  ·  V4L2  ·  libcamera  ·  uvicorn / FastAPI" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#999999;fontSize=10;fontStyle=2;align=center;" vertex="1" parent="1">
