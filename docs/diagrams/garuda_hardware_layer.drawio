          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- OR label between cameras -->
        <mxCell id="or" value="— or —" style="text;html=1;align=center;verticalAlign=middle;resizable=0;strokeColor=none;fillColor=none;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="110" y="283" width="80" height="20" as="geometry" />
