        <!-- Config persistence -->
        <mxCell id="cfg" value="Config Persistence&#xa;(save_config L580)&#xa;stores KNOWN_DEVICES&#xa;in config.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" vertex="1" parent="1">
