        <mxCell id="eq6" value="&#x394;t = t_now &#x2212; t_last_heartbeat&#xa;TAMPER if &#x394;t &gt; 180s (bypass DND)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 5;fillColor=#E8F4FD;strokeColor=#4A90D9;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1015" y="273" width="230" height="35" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="Schedule Engine&#xa;Mode transitions (HH:MM rules)&#xa;Checks every 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1015" y="325" width="195" height="45" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="Log Flush Thread&#xa;RAM buffer &#x2192; disk every 60s&#xa;Reduces SSD wear" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1015" y="390" width="195" height="42" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="Connectivity Monitor&#xa;DNS probe 1.1.1.1 every 30s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1015" y="450" width="195" height="38" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="WS Broadcaster&#xa;State push every 2s&#xa;+ event-driven urgent push" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1015" y="505" width="195" height="42" as="geometry" />
        </mxCell>

