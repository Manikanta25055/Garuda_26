        <mxCell id="w1" value="PBKDF2-SHA256 (c = 600,000)&#xa;Sessions: 15 min access / 7 d refresh&#xa;Admin 2FA: OTP 6-digit, 10 min TTL&#xa;Master Key: 8 h validity&#xa;RBAC: admin / user roles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="1525" width="225" height="82" as="geometry" />
        </mxCell>

        <!-- PBKDF2 equation -->
        <mxCell id="eq5" value="DK = PBKDF2(HMAC-SHA256, pwd, salt, c=600000, dkLen=32)&#xa;OTP = random &#x2208; [100000, 999999], TTL = 600s&#xa;Token = secrets.token_hex(64)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=5 5;fillColor=#E8F4FD;strokeColor=#4A90D9;fontSize=9;fontStyle=2;" vertex="1" parent="1">
