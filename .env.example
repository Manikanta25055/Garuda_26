# Copy to .env in this directory and fill in. `chmod 600 .env` after writing it.
#
# THIS directory is the one that counts. Garuda_web.py calls load_dotenv() with
# no argument, which walks up from the process working directory -- and the
# service sets WorkingDirectory=/home/manikanta/Projects/Garuda_26. A .env in a
# git worktree, or anywhere else on the machine, is simply not read. A key put
# in the wrong copy fails exactly like a wrong key: HTTP 403 from NVIDIA.
#
# Every line is KEY=VALUE. A bare value on a line of its own is not a variable;
# python-dotenv skips it silently and os.environ.get() returns the default.

# ── Rule synthesis (the composer: "teach a new rule") ───────────────────────
# Without NIM_API_KEY the composer still answers questions from the local
# matcher; only compiling a NEW rule needs the cloud. Key is ~70 characters and
# starts with nvapi-.
NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIM_FALLBACK_MODELS=z-ai/glm-5.3-flash,openai/gpt-oss-20b

# ── Alert email ────────────────────────────────────────────────────────────
EMAIL_SENDER=you@gmail.com
EMAIL_SENDER_PASS=app-password-not-your-login-password
EMAIL_RECIPIENTS=someone@example.com,someone-else@example.com

# ── Web session cookies ────────────────────────────────────────────────────
# 1 behind HTTPS (the cloudflared tunnel), 0 for plain-HTTP local development.
SECURE_COOKIES=1

# ── Narada voice (ElevenLabs) ──────────────────────────────────────────────
# Both are needed; the engine id is written by scripts/setup_narada_voice.py.
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_SPEECH_ENGINE_ID=
# ELEVENLABS_VOICE_ID=

# ── Safety nets ────────────────────────────────────────────────────────────
# MASTER_KEY seeds the first master key on a machine that has none; it is
# stored hashed in system_logs/master_keys.json and can be removed from here
# after the first start.
# MASTER_KEY=
# HEARTBEAT_KEY=                           # required by /api/heartbeat to reset the dead-man switch

# ── Service ────────────────────────────────────────────────────────────────
# GARUDA_HOST=127.0.0.1                    # keep on loopback: the tunnel is the only way in
# GARUDA_PORT=8080
# GARUDA_LOG_LEVEL=INFO                    # system_logs/garuda.log (rotating, 5 MB x 3)
# GARUDA_BACKUP_KEEP=14                    # daily state archives kept in system_logs/backups/auto
# GARUDA_VERCEL_PROJECT=garuda-26          # Vercel project allowed to call the API cross-origin
# GARUDA_SECURITY_HOSTS=garuda.veeramanikanta.in   # hosts that get the security-only product
#
# What the running service makes of all this (missing or malformed values and
# what they cost) is on GET /api/system/info, and in the log at start-up.

# ── Optional ───────────────────────────────────────────────────────────────
# DRISHTI_HOST=drishti.veeramanikanta.in   # Host header that selects the Drishti bundle
# DRISHTI_MQTT_HOST=localhost              # broker for mqtt-transport devices
# DRISHTI_MATCHER=fuzzy                    # fuzzy | embedding
# DEADMAN_ENABLED=1

# ── Set by the systemd unit, not here ──────────────────────────────────────
# GARUDA_EVAL_TOKEN, GARUDA_EVAL_SERVICE_ADMIN, GARUDA_EVAL_OTP_BYPASS and the
# EXFIL_* group belong to the evaluation harness and live in the unit's
# EnvironmentFile so they are not readable by every account on the box.
