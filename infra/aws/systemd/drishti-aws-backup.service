[Unit]
Description=Drishti: changed state, model and kept capture files to S3 (optional AWS add-on)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=manikanta
WorkingDirectory=/home/manikanta/Projects/Garuda_26
# aws_agent.py reads the AWS settings and the upload-only key from .env (chmod 600).
ExecStart=/usr/bin/python3 /home/manikanta/Projects/Garuda_26/scripts/aws_agent.py backup
Nice=15
IOSchedulingClass=idle
